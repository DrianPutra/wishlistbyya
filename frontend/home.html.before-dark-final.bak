<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>WishlistByYa</title>

    <link
        href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Poppins:wght@400;500;600&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    >

    <style>

        :root {
            --bg-color: #FAF9F6;
            --card-bg: #FFFFFF;

            --dark-primary: #2D2D2D;
            --dark-hover: #454545;

            --beige: #F2EDE9;
            --beige-dark: #E4DDD5;

            --border-color: #DCD6CD;

            --text-dark: #2D2D2D;
            --text-muted: #8C857B;

            --shadow:
                0 15px 40px rgba(45,45,45,0.07);
        }


        * {
            margin: 0;
            padding: 0;

            box-sizing: border-box;

            font-family:
                "Poppins",
                sans-serif;
        }


        body {
            min-height: 100vh;

            background:
                linear-gradient(
                    135deg,
                    #FAF9F6,
                    #F2EDE9
                );

            color:
                var(--text-dark);

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 24px;
        }


        .container {
            width: 100%;
            max-width: 920px;
        }


        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 34px;
        }


        .welcome-small {
            font-size: 13px;

            color:
                var(--text-muted);

            margin-bottom: 3px;
        }


        .username {
            font-family:
                "Fredoka",
                sans-serif;

            font-size: 25px;
            font-weight: 600;
        }


        .logout {
            border:
                1px solid var(--border-color);

            background:
                rgba(255,255,255,0.7);

            color:
                var(--text-dark);

            border-radius: 12px;

            padding:
                9px 14px;

            cursor: pointer;

            font-size: 12px;
            font-weight: 500;

            transition:
                0.2s ease;
        }


        .logout:hover {
            background:
                #FFFFFF;
        }


        .heading {
            text-align: center;

            margin-bottom: 30px;
        }


        .heading h1 {
            font-family:
                "Fredoka",
                sans-serif;

            font-size:
                clamp(
                    28px,
                    5vw,
                    40px
                );

            font-weight: 600;

            margin-bottom: 8px;
        }


        .heading p {
            color:
                var(--text-muted);

            font-size: 14px;
        }


        .app-grid {
            display: grid;

            grid-template-columns:
                repeat(
                    2,
                    minmax(0, 1fr)
                );

            gap: 20px;
        }


        .app-card {
            border:
                1px solid
                var(--border-color);

            background:
                rgba(
                    255,
                    255,
                    255,
                    0.92
                );

            border-radius: 24px;

            min-height: 260px;

            padding: 30px;

            box-shadow:
                var(--shadow);

            cursor: pointer;

            text-align: left;

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                border-color 0.25s ease;
        }


        .app-card:hover {
            transform:
                translateY(-5px);

            border-color:
                #BFB7AD;

            box-shadow:
                0 20px 45px
                rgba(45,45,45,0.10);
        }


        .app-icon {
            width: 58px;
            height: 58px;

            border-radius: 17px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                var(--beige);

            color:
                var(--dark-primary);

            font-size: 22px;

            margin-bottom: 26px;
        }


        .app-card h2 {
            font-family:
                "Fredoka",
                sans-serif;

            font-size: 24px;

            margin-bottom: 8px;
        }


        .app-card p {
            color:
                var(--text-muted);

            font-size: 13px;

            line-height: 1.7;

            margin-bottom: 26px;
        }


        .open-text {
            font-size: 13px;
            font-weight: 600;

            display: flex;
            align-items: center;

            gap: 7px;
        }


        @media (
            max-width: 650px
        ) {

            body {
                align-items:
                    flex-start;

                padding:
                    22px 18px;
            }


            .container {
                padding-top:
                    12px;
            }


            .topbar {
                margin-bottom:
                    30px;
            }


            .app-grid {
                grid-template-columns:
                    1fr;

                gap: 14px;
            }


            .app-card {
                min-height:
                    190px;

                padding: 24px;
            }


            .app-icon {
                margin-bottom:
                    19px;
            }


            .heading {
                text-align:
                    left;
            }

        }


        /* =====================================================
           HOME VERTICAL OPTIONS START
        ===================================================== */

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow-y: auto;
        }


        .container {
            width: 100%;
            max-width: 620px;

            min-height: auto;

            margin: 0 auto;
        }


        .heading {
            text-align: center;
        }


        .app-grid {
            display: flex !important;

            flex-direction: column !important;

            align-items: center !important;

            width: 100%;
            max-width: 520px;

            margin:
                0 auto;

            gap: 16px !important;
        }


        .app-card {
            width: 100% !important;

            min-height: 170px !important;

            padding: 25px 28px !important;

            flex-shrink: 0;
        }


        .app-icon {
            width: 50px;
            height: 50px;

            margin-bottom: 17px;
        }


        .app-card h2 {
            margin-bottom: 5px;
        }


        .app-card p {
            margin-bottom: 17px;
        }


        @media (max-width: 650px) {

            body {
                min-height: 100vh;

                align-items: center !important;

                padding:
                    20px 16px !important;
            }


            .container {
                width: 100%;

                padding-top: 0 !important;
            }


            .topbar {
                margin-bottom:
                    24px;
            }


            .heading {
                text-align: center !important;

                margin-bottom:
                    22px;
            }


            .app-grid {
                width: 100%;

                max-width: 430px;

                gap: 12px !important;
            }


            .app-card {
                min-height: 150px !important;

                padding:
                    20px 22px !important;
            }


            .app-icon {
                width: 44px;
                height: 44px;

                margin-bottom:
                    13px;
            }


            .app-card h2 {
                font-size:
                    21px;
            }


            .app-card p {
                font-size:
                    12px;

                margin-bottom:
                    13px;
            }

        }

        /* HOME VERTICAL OPTIONS END */

        /* =====================================================
           SIMPLE HOME BUTTONS FINAL START
        ===================================================== */

        /* Hilangkan heading dan isi card lama */

        .heading {
            display: none !important;
        }

        .app-icon,
        .app-card h2,
        .app-card p,
        .open-text i {
            display: none !important;
        }


        /* Container utama */

        .container {
            width: 100% !important;
            max-width: 620px !important;
        }


        /* Area dua pilihan */

        .app-grid {
            display: flex !important;
            flex-direction: column !important;

            align-items: center !important;
            justify-content: center !important;

            gap: 12px !important;

            width: 100% !important;
            max-width: 260px !important;

            margin: 60px auto 0 !important;
        }


        /* Tombol simple */

        .app-card {
            width: 100% !important;
            min-height: 0 !important;

            padding: 12px 18px !important;

            border: none !important;
            border-radius: 10px !important;

            background: #2D2D2D !important;

            box-shadow: none !important;

            color: #FFFFFF !important;

            text-align: center !important;

            cursor: pointer !important;

            transition:
                background 0.2s ease,
                transform 0.2s ease !important;
        }


        .app-card:hover {
            background: #454545 !important;

            transform:
                translateY(-1px) !important;

            box-shadow:
                none !important;
        }


        .open-text {
            display: block !important;

            margin: 0 !important;

            color: #FFFFFF !important;

            font-size: 13px !important;
            font-weight: 600 !important;

            text-align: center !important;
        }


        @media (max-width: 650px) {

            body {
                align-items: center !important;
            }

            .app-grid {
                max-width: 220px !important;

                margin:
                    45px auto 0 !important;

                gap: 10px !important;
            }

            .app-card {
                padding:
                    11px 16px !important;
            }

            .open-text {
                font-size:
                    12px !important;
            }

        }

        /* SIMPLE HOME BUTTONS FINAL END */

        /* =====================================================
           HOME ACCOUNT MENU START
        ===================================================== */

        .home-user-menu {
            position: relative;
            z-index: 50;
        }


        .menu-toggle {
            width: 42px;
            height: 42px;

            border:
                1px solid
                var(--border-color);

            border-radius: 12px;

            background:
                var(--card-bg);

            color:
                var(--text-dark);

            display: flex;
            align-items: center;
            justify-content: center;

            cursor: pointer;

            font-size: 16px;

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }


        .menu-toggle:hover {
            background:
                var(--beige);

            transform:
                translateY(-1px);
        }


        .account-menu {
            position: absolute;

            top: calc(100% + 10px);
            right: 0;

            width: 245px;

            padding: 10px;

            border:
                1px solid
                var(--border-color);

            border-radius: 16px;

            background:
                var(--card-bg);

            box-shadow:
                0 18px 45px
                rgba(45,45,45,0.12);

            opacity: 0;
            visibility: hidden;

            transform:
                translateY(-6px);

            transition:
                opacity 0.18s ease,
                transform 0.18s ease,
                visibility 0.18s ease;
        }


        .account-menu.active {
            opacity: 1;
            visibility: visible;

            transform:
                translateY(0);
        }


        .account-profile {
            display: flex;
            align-items: center;

            gap: 10px;

            padding:
                8px;
        }


        .account-avatar {
            width: 42px;
            height: 42px;

            flex-shrink: 0;

            border-radius: 50%;

            background:
                var(--dark-primary);

            color: #FFFFFF;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            font-size: 13px;
            font-weight: 600;
        }


        .account-avatar img {
            width: 100%;
            height: 100%;

            object-fit: cover;
        }


        .account-profile-info {
            min-width: 0;

            text-align: left;
        }


        .account-name {
            color:
                var(--text-dark);

            font-size: 12px;
            font-weight: 600;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .account-email {
            margin-top: 2px;

            color:
                var(--text-muted);

            font-size: 9px;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .account-menu-divider {
            height: 1px;

            background:
                var(--border-color);

            margin:
                6px 4px;
        }


        .account-menu-item {
            width: 100%;

            border: none;

            border-radius: 9px;

            background:
                transparent;

            color:
                var(--text-dark);

            display: flex;
            align-items: center;

            gap: 10px;

            padding:
                10px 11px;

            cursor: pointer;

            text-align: left;

            font-size: 11px;
            font-weight: 500;

            transition:
                background 0.15s ease;
        }


        .account-menu-item:hover {
            background:
                var(--beige);
        }


        .account-menu-item i {
            width: 15px;

            text-align: center;
        }


        .logout-item {
            color:
                #9C5D5D;
        }


        @media (max-width: 650px) {

            .account-menu {
                width: 220px;
            }


            .menu-toggle {
                width: 40px;
                height: 40px;
            }

        }

        /* HOME ACCOUNT MENU END */

        /* =====================================================
           HOME LOGIN CARD START
        ===================================================== */

        body {
            min-height: 100vh !important;

            display: flex !important;
            align-items: center !important;
            justify-content: center !important;

            padding: 24px !important;
        }


        .container {
            width: 100% !important;
            max-width: 470px !important;

            margin: 0 auto !important;

            padding:
                38px 34px 36px !important;

            background:
                #FFFFFF !important;

            border:
                1.5px solid
                var(--border-color) !important;

            border-radius:
                28px !important;

            box-shadow:
                0 15px 35px
                rgba(45,45,45,0.08) !important;
        }


        .topbar {
            width: 100% !important;

            margin-bottom:
                0 !important;
        }


        .welcome-small {
            font-size:
                13px !important;

            margin-bottom:
                3px;
        }


        .username {
            font-size:
                25px !important;
        }


        .app-grid {
            width: 100% !important;

            max-width:
                100% !important;

            margin:
                34px auto 0 !important;

            gap:
                12px !important;
        }


        .app-card {
            width: 100% !important;

            padding:
                13px 18px !important;

            border-radius:
                13px !important;
        }


        .open-text {
            font-size:
                13px !important;
        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 650px) {

            body {
                padding:
                    18px 14px !important;
            }


            .container {
                max-width:
                    400px !important;

                padding:
                    28px 22px 26px !important;

                border-radius:
                    23px !important;
            }


            .username {
                font-size:
                    22px !important;
            }


            .menu-toggle {
                width:
                    40px !important;

                height:
                    40px !important;

                border-radius:
                    11px !important;
            }


            .app-grid {
                max-width:
                    100% !important;

                margin:
                    28px auto 0 !important;

                gap:
                    10px !important;
            }


            .app-card {
                width:
                    100% !important;

                padding:
                    12px 16px !important;
            }


            .open-text {
                font-size:
                    12px !important;
            }

        }


        @media (max-width: 380px) {

            .container {
                padding:
                    24px 18px !important;

                border-radius:
                    20px !important;
            }


            .username {
                font-size:
                    20px !important;
            }

        }

        /* HOME LOGIN CARD END */
</style>


    <!-- GLOBAL THEME BOOT START -->
    <script>
        (function () {
            try {

                var theme =
                    localStorage.getItem(
                        "nekoya_theme"
                    ) ||
                    localStorage.getItem(
                        "wishlist_theme"
                    ) ||
                    "light";


                document.documentElement.dataset.theme =
                    theme === "dark"
                        ? "dark"
                        : "light";

            } catch (error) {

                document.documentElement.dataset.theme =
                    "light";
            }
        })();
    </script>
    <!-- GLOBAL THEME BOOT END -->

    <link
        rel="stylesheet"
        href="css/theme.css"
    >
<style id="global-dark-theme-fix">
/* =========================================================
   GLOBAL DARK THEME FIX
   ========================================================= */

body.dark-theme,
html.dark-theme body,
[data-theme="dark"],
[data-theme="dark"] body {
    --dark-bg: #0f0c0b;
    --dark-surface: #1b1715;
    --dark-surface-2: #231d1a;
    --dark-border: rgba(210, 185, 155, 0.18);
    --dark-text: #f7efe8;
    --dark-muted: #c9b7a6;
    --dark-soft: #a8927e;
    --dark-accent: #f5eee7;
    --dark-accent-text: #1c1715;
    --dark-chip: #2b2421;
}

/* =========================================================
   PAGE BACKGROUND
   ========================================================= */

body.dark-theme,
html.dark-theme body,
[data-theme="dark"] body {
    background: var(--dark-bg) !important;
    color: var(--dark-text) !important;
}

/* =========================================================
   TEXT FIX
   ========================================================= */

body.dark-theme h1,
body.dark-theme h2,
body.dark-theme h3,
body.dark-theme h4,
body.dark-theme h5,
body.dark-theme h6,
body.dark-theme p,
body.dark-theme span,
body.dark-theme div,
body.dark-theme label,
body.dark-theme a,
[data-theme="dark"] h1,
[data-theme="dark"] h2,
[data-theme="dark"] h3,
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6,
[data-theme="dark"] p,
[data-theme="dark"] span,
[data-theme="dark"] div,
[data-theme="dark"] label,
[data-theme="dark"] a {
    color: inherit;
}

body.dark-theme .text-muted,
body.dark-theme .subtitle,
body.dark-theme .welcome-label,
body.dark-theme .section-subtitle,
body.dark-theme .empty-subtitle,
body.dark-theme .note-subtitle,
body.dark-theme .member-role,
body.dark-theme .meta-text,
body.dark-theme .helper-text,
[data-theme="dark"] .text-muted,
[data-theme="dark"] .subtitle,
[data-theme="dark"] .welcome-label,
[data-theme="dark"] .section-subtitle,
[data-theme="dark"] .empty-subtitle,
[data-theme="dark"] .note-subtitle,
[data-theme="dark"] .member-role,
[data-theme="dark"] .meta-text,
[data-theme="dark"] .helper-text {
    color: var(--dark-muted) !important;
}

body.dark-theme .accent-text,
body.dark-theme .brand-text,
body.dark-theme .user-name,
body.dark-theme .note-title,
body.dark-theme .page-title,
body.dark-theme .section-title,
[data-theme="dark"] .accent-text,
[data-theme="dark"] .brand-text,
[data-theme="dark"] .user-name,
[data-theme="dark"] .note-title,
[data-theme="dark"] .page-title,
[data-theme="dark"] .section-title {
    color: var(--dark-text) !important;
}

/* =========================================================
   CARD / CONTAINER FIX
   ========================================================= */

body.dark-theme .welcome-card,
body.dark-theme .home-card,
body.dark-theme .hero-card,
body.dark-theme .top-card,
body.dark-theme .summary-card,
body.dark-theme .section-card,
body.dark-theme .note-card,
body.dark-theme .note-editor-card,
body.dark-theme .editor-card,
body.dark-theme .member-card,
body.dark-theme .members-card,
body.dark-theme .toolbar-card,
body.dark-theme .dropdown-menu,
body.dark-theme .menu-dropdown,
body.dark-theme .profile-dropdown,
body.dark-theme .modal-content,
body.dark-theme .share-modal-content,
[data-theme="dark"] .welcome-card,
[data-theme="dark"] .home-card,
[data-theme="dark"] .hero-card,
[data-theme="dark"] .top-card,
[data-theme="dark"] .summary-card,
[data-theme="dark"] .section-card,
[data-theme="dark"] .note-card,
[data-theme="dark"] .note-editor-card,
[data-theme="dark"] .editor-card,
[data-theme="dark"] .member-card,
[data-theme="dark"] .members-card,
[data-theme="dark"] .toolbar-card,
[data-theme="dark"] .dropdown-menu,
[data-theme="dark"] .menu-dropdown,
[data-theme="dark"] .profile-dropdown,
[data-theme="dark"] .modal-content,
[data-theme="dark"] .share-modal-content {
    background: linear-gradient(135deg, #1c1715 0%, #211b18 100%) !important;
    color: var(--dark-text) !important;
    border: 1px solid var(--dark-border) !important;
    box-shadow: none !important;
}

/* =========================================================
   INPUT / EDITOR FIX
   ========================================================= */

body.dark-theme input,
body.dark-theme textarea,
body.dark-theme select,
body.dark-theme .editor,
body.dark-theme .note-editor,
body.dark-theme .note-content,
body.dark-theme .title-input,
[data-theme="dark"] input,
[data-theme="dark"] textarea,
[data-theme="dark"] select,
[data-theme="dark"] .editor,
[data-theme="dark"] .note-editor,
[data-theme="dark"] .note-content,
[data-theme="dark"] .title-input {
    background: #221c19 !important;
    color: var(--dark-text) !important;
    border: 1px solid var(--dark-border) !important;
}

body.dark-theme input::placeholder,
body.dark-theme textarea::placeholder,
[data-theme="dark"] input::placeholder,
[data-theme="dark"] textarea::placeholder {
    color: var(--dark-soft) !important;
}

/* =========================================================
   BUTTON FIX
   ========================================================= */

body.dark-theme .btn,
body.dark-theme button,
body.dark-theme .action-btn,
body.dark-theme .menu-btn,
body.dark-theme .profile-btn,
body.dark-theme .home-nav-btn,
body.dark-theme .primary-btn,
body.dark-theme .secondary-btn,
[data-theme="dark"] .btn,
[data-theme="dark"] button,
[data-theme="dark"] .action-btn,
[data-theme="dark"] .menu-btn,
[data-theme="dark"] .profile-btn,
[data-theme="dark"] .home-nav-btn,
[data-theme="dark"] .primary-btn,
[data-theme="dark"] .secondary-btn {
    border-color: var(--dark-border) !important;
}

body.dark-theme .btn-primary,
body.dark-theme .primary-btn,
body.dark-theme .btn-dark,
body.dark-theme .main-action,
[data-theme="dark"] .btn-primary,
[data-theme="dark"] .primary-btn,
[data-theme="dark"] .btn-dark,
[data-theme="dark"] .main-action {
    background: var(--dark-accent) !important;
    color: var(--dark-accent-text) !important;
    border: none !important;
}

body.dark-theme .btn-primary *,
body.dark-theme .primary-btn *,
body.dark-theme .btn-dark *,
body.dark-theme .main-action *,
[data-theme="dark"] .btn-primary *,
[data-theme="dark"] .primary-btn *,
[data-theme="dark"] .btn-dark *,
[data-theme="dark"] .main-action * {
    color: var(--dark-accent-text) !important;
}

body.dark-theme .btn-secondary,
body.dark-theme .secondary-btn,
body.dark-theme .ghost-btn,
body.dark-theme .back-btn,
[data-theme="dark"] .btn-secondary,
[data-theme="dark"] .secondary-btn,
[data-theme="dark"] .ghost-btn,
[data-theme="dark"] .back-btn {
    background: transparent !important;
    color: var(--dark-text) !important;
    border: 1px solid var(--dark-border) !important;
}

/* =========================================================
   CHIP / BADGE FIX
   ========================================================= */

body.dark-theme .badge,
body.dark-theme .role-badge,
body.dark-theme .status-badge,
body.dark-theme .chip,
body.dark-theme .pill,
body.dark-theme .member-pill,
[data-theme="dark"] .badge,
[data-theme="dark"] .role-badge,
[data-theme="dark"] .status-badge,
[data-theme="dark"] .chip,
[data-theme="dark"] .pill,
[data-theme="dark"] .member-pill {
    background: var(--dark-chip) !important;
    color: var(--dark-text) !important;
    border: 1px solid var(--dark-border) !important;
}

/* =========================================================
   DROPDOWN / MENU FIX
   ========================================================= */

body.dark-theme .dropdown-menu a,
body.dark-theme .menu-dropdown a,
body.dark-theme .profile-dropdown a,
body.dark-theme .dropdown-menu button,
body.dark-theme .menu-dropdown button,
body.dark-theme .profile-dropdown button,
[data-theme="dark"] .dropdown-menu a,
[data-theme="dark"] .menu-dropdown a,
[data-theme="dark"] .profile-dropdown a,
[data-theme="dark"] .dropdown-menu button,
[data-theme="dark"] .menu-dropdown button,
[data-theme="dark"] .profile-dropdown button {
    color: var(--dark-text) !important;
    background: transparent !important;
}

body.dark-theme .dropdown-menu a:hover,
body.dark-theme .menu-dropdown a:hover,
body.dark-theme .profile-dropdown a:hover,
body.dark-theme .dropdown-menu button:hover,
body.dark-theme .menu-dropdown button:hover,
body.dark-theme .profile-dropdown button:hover,
[data-theme="dark"] .dropdown-menu a:hover,
[data-theme="dark"] .menu-dropdown a:hover,
[data-theme="dark"] .profile-dropdown a:hover,
[data-theme="dark"] .dropdown-menu button:hover,
[data-theme="dark"] .menu-dropdown button:hover,
[data-theme="dark"] .profile-dropdown button:hover {
    background: rgba(255,255,255,0.05) !important;
    color: var(--dark-text) !important;
}

/* =========================================================
   NOTE PAGE SPECIFIC
   ========================================================= */

body.dark-theme .note-page,
body.dark-theme .note-shell,
body.dark-theme .editor-shell,
body.dark-theme .note-main,
[data-theme="dark"] .note-page,
[data-theme="dark"] .note-shell,
[data-theme="dark"] .editor-shell,
[data-theme="dark"] .note-main {
    background: transparent !important;
    color: var(--dark-text) !important;
}

body.dark-theme .note-title-input,
body.dark-theme .note-content-input,
body.dark-theme .note-editor-title,
body.dark-theme .note-editor-content,
[data-theme="dark"] .note-title-input,
[data-theme="dark"] .note-content-input,
[data-theme="dark"] .note-editor-title,
[data-theme="dark"] .note-editor-content {
    background: #221c19 !important;
    color: var(--dark-text) !important;
}

/* =========================================================
   HOME PAGE SPECIFIC
   ========================================================= */

body.dark-theme .welcome-card .brand-text,
body.dark-theme .welcome-card .username,
body.dark-theme .welcome-card .title,
body.dark-theme .welcome-card h1,
body.dark-theme .welcome-card h2,
body.dark-theme .welcome-card h3,
[data-theme="dark"] .welcome-card .brand-text,
[data-theme="dark"] .welcome-card .username,
[data-theme="dark"] .welcome-card .title,
[data-theme="dark"] .welcome-card h1,
[data-theme="dark"] .welcome-card h2,
[data-theme="dark"] .welcome-card h3 {
    color: var(--dark-text) !important;
}

body.dark-theme .welcome-card p,
body.dark-theme .welcome-card span,
[data-theme="dark"] .welcome-card p,
[data-theme="dark"] .welcome-card span {
    color: var(--dark-muted) !important;
}
</style>
</head>


<body>

    <main class="container">

        <div class="topbar">

            <div>

                <div class="welcome-small">
                    Welcome back
                </div>

                <div
                    class="username"
                    id="homeUsername"
                >
                    ...
                </div>

            </div>


            <div class="home-user-menu">

                <button
                    class="menu-toggle"
                    id="homeMenuToggle"
                    type="button"
                    aria-label="Buka menu akun"
                    aria-expanded="false"
                >
                    <i class="fa-solid fa-bars"></i>
                </button>


                <div
                    class="account-menu"
                    id="homeAccountMenu"
                >

                    <div class="account-profile">

                        <div
                            class="account-avatar"
                            id="homeMenuAvatar"
                        >
                            --
                        </div>

                        <div class="account-profile-info">

                            <div
                                class="account-name"
                                id="homeMenuName"
                            >
                                User
                            </div>

                            <div
                                class="account-email"
                                id="homeMenuEmail"
                            >
                                -
                            </div>

                        </div>

                    </div>


                    <div class="account-menu-divider"></div>


                    <button
                        class="account-menu-item"
                        type="button"
                        onclick="openProfile()"
                    >

                        <i class="fa-regular fa-user"></i>

                        Edit Profile

                    </button>


                    <button
                        class="account-menu-item logout-item"
                        type="button"
                        onclick="logout()"
                    >

                        <i class="fa-solid fa-arrow-right-from-bracket"></i>

                        Logout

                    </button>

                </div>

            </div>

        </div>


        <section class="heading">

            <h1>
                What do you want to open?
            </h1>

            <p>
                Pilih tempat yang ingin kamu buka.
            </p>

        </section>


        <section class="app-grid">


            <button
                class="app-card"
                type="button"
                onclick="openFolders()"
            >

                <div class="app-icon">

                    <i
                        class="fa-regular fa-folder-open"
                    ></i>

                </div>

                <h2>
                    Folder
                </h2>

                <p>
                    Buka semua folder wishlist,
                    wishlist pribadi, dan wishlist
                    yang dibagikan denganmu.
                </p>

                <div class="open-text">

                    Open Folder

                    <i
                        class="fa-solid fa-arrow-right"
                    ></i>

                </div>

            </button>


            <button
                class="app-card"
                type="button"
                onclick="openNotes()"
            >

                <div class="app-icon">

                    <i
                        class="fa-regular fa-note-sticky"
                    ></i>

                </div>

                <h2>
                    Note
                </h2>

                <p>
                    Simpan catatan pribadi dan
                    buka catatan yang dibagikan
                    bersama orang lain.
                </p>

                <div class="open-text">

                    Open Note

                    <i
                        class="fa-solid fa-arrow-right"
                    ></i>

                </div>

            </button>


        </section>

    </main>


    <script src="js/api.js"></script>

    <script src="js/auth-guard.js"></script>

    <script src="js/home.js"></script>


    <script src="js/theme.js"></script>
</body>

</html>